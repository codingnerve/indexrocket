# ---- IndexRocket Web ------------------------------------------------------
# NEXT_PUBLIC_ variables are inlined into the browser bundle at BUILD time.
# Changing this requires a rebuild (npm run build), not just a restart.
# It is public by design: never put a secret in a NEXT_PUBLIC_ variable.
#
# Production: https://api.theflyventures.com
NEXT_PUBLIC_API_URL=http://localhost:5000
