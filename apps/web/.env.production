# ---- IndexRocket Web — production build configuration (committed) ----------
# Loaded automatically by `next build` and `next start` (NODE_ENV=production).
# `next dev` never reads this file, so development keeps http://localhost:5000.
#
# PUBLIC VALUES ONLY. Everything here is inlined into the browser bundle.
# Never add secrets (Google client secret, ENCRYPTION_KEY, Redis or MongoDB
# credentials); those belong only in /etc/indexrocket/api.env and worker.env.
#
# A shell variable of the same name, or an apps/web/.env.production.local /
# .env.local file, takes precedence over this file (see docs/PRODUCTION.md §5).
NEXT_PUBLIC_API_URL=https://api.theflyventures.com
