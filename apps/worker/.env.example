# ---- IndexRocket Worker ---------------------------------------------------
# Copy to .env for local development. In production, supply these through the
# process manager and never commit real values. See docs/PRODUCTION.md.

NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/indexrocket
REDIS_URL=redis://127.0.0.1:6379

# MUST be the same value as the API's ENCRYPTION_KEY: the worker decrypts the
# stored Google tokens for batches that opt into Google inspection.
ENCRYPTION_KEY=

# Only needed for batches with Google inspection enabled; same values as the API.
# All three or none. Production redirect: https://api.theflyventures.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

WORKER_CONCURRENCY=5
SUBMISSION_CONCURRENCY=3

# Discovery (IndexNow). Keys are stored per project in MongoDB, never here.
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow
DISCOVERY_CONCURRENCY=2
DISCOVERY_RATE_MAX=10
DISCOVERY_RATE_DURATION_MS=60000

# Local health endpoint (GET /health, /ready). 0 disables. Keep it on loopback.
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=5100

# How long a deploy waits for in-flight jobs before exiting. Keep your process
# manager's stop timeout above this (systemd TimeoutStopSec).
WORKER_SHUTDOWN_TIMEOUT_MS=60000
