# ---- IndexRocket API ------------------------------------------------------
# Copy to .env for local development. In production, supply these through the
# process manager (e.g. a systemd EnvironmentFile readable only by the service
# user) and never commit real values. See docs/PRODUCTION.md.

NODE_ENV=development
# Development: 5000. Production: 5101 (the Nginx upstream in deploy/ expects it).
PORT=5000
# Listen address. Blank = all interfaces in development, 127.0.0.1 in production
# (Nginx on the same host). Set a private address only if Nginx runs elsewhere.
HOST=

# Browser origin of the frontend (exact match, used for CORS and CSRF checks).
# Production: https://app.theflyventures.com  (must be https, must not be localhost)
FRONTEND_URL=http://localhost:3000

# Production: include credentials, e.g.
#   mongodb://indexrocket:<password>@127.0.0.1:27017/indexrocket?authSource=indexrocket
MONGODB_URI=mongodb://127.0.0.1:27017/indexrocket

# Production: enable Redis AUTH, e.g. redis://:<password>@127.0.0.1:6379
# (or rediss:// for TLS to a remote Redis)
REDIS_URL=redis://127.0.0.1:6379

# Encrypts Google OAuth tokens at rest (AES-256-GCM).
# MUST be identical for the API and the worker.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production; development falls back to a well-known dev key.
ENCRYPTION_KEY=

# Google Search Console OAuth (Google Cloud Console -> Credentials -> OAuth client ID -> Web application).
# Leave blank to disable the integration; the routes then answer 503.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production: https://api.theflyventures.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Express "trust proxy". Blank = off in development, "loopback" in production
# (Nginx on the same host). Needed so client IPs (and login throttling) are real.
TRUST_PROXY=

# Successful registrations allowed per client address per hour.
# Blank = 10 in production, 1000 in development.
REGISTER_RATE_MAX=
